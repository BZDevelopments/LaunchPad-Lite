# ╔══════════════════════════════════════════════════════════════════╗
# ║           LAUNCHPAD — ENVIRONMENT VARIABLES                      ║
# ║  Copy this file to .env.local and fill in your values.          ║
# ║  Run `npm run launchpad:check` to validate your configuration.  ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── APP ──────────────────────────────────────────────────────────────────────
# Must exactly match the URL you actually visit the app at (including port
# in dev). Used to build OAuth callback URLs and email links server-side.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── DATABASE (PostgreSQL / Neon / Supabase) ─────────────────────────────────
# DATABASE_URL: your app's runtime connection. On Supabase/Neon, use the
# POOLED connection string (e.g. Supabase port 6543).
DATABASE_URL=postgresql://user:password@localhost:5432/launchpad_dev

# DIRECT_URL: used only by drizzle-kit (db:push/generate/studio) to
# introspect your schema. Pooled connections don't support this. On
# Supabase: same pooler hostname, port 5432 instead of 6543.
DIRECT_URL=postgresql://user:password@localhost:5432/launchpad_dev

# ─── BETTER AUTH ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
# (Windows without Git Bash/WSL: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=your-super-secret-key-min-32-chars

# ─── OAUTH PROVIDERS ──────────────────────────────────────────────────────────
# See README "Set Up Google Sign-In" / "Set Up GitHub Sign-In" for full steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── AI PROVIDERS (only needed if features.modules.ai is true) ──────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── PAYMENTS (only needed if siteType is "saas" or modules.shop is true) ────
PAYMENT_PROVIDER=stripe

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_PRO_PRODUCT_ID=prod_...
STRIPE_TEAM_MONTHLY_PRICE_ID=price_...
STRIPE_TEAM_YEARLY_PRICE_ID=price_...
STRIPE_TEAM_PRODUCT_ID=prod_...

# LemonSqueezy (alternative to Stripe for subscriptions)
LS_API_KEY=
LS_STORE_ID=
LS_WEBHOOK_SECRET=
LS_PRO_MONTHLY_VARIANT_ID=
LS_PRO_YEARLY_VARIANT_ID=
LS_PRO_PRODUCT_ID=
LS_TEAM_MONTHLY_VARIANT_ID=
LS_TEAM_YEARLY_VARIANT_ID=
LS_TEAM_PRODUCT_ID=

# ─── STORAGE (only needed for file uploads / Knowledge Base) ────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=launchpad-uploads

# AWS S3 (alternative)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ─── EMAIL (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# Leave unset to use Resend's built-in testing address "onboarding@resend.dev"
# — this works with ZERO setup, but Resend will only deliver it to the email
# address you signed up to Resend with (not to your actual test users' real
# emails). This is intentional on Resend's part, not a bug in this app.
#
# To send verification/reset/order emails to REAL users, you must:
#   1. Verify a domain you own in your Resend dashboard (Domains → Add Domain)
#   2. Set RESEND_FROM_EMAIL=noreply@yourdomain.com (must be on that domain)
RESEND_FROM_EMAIL=

# ─── RATE LIMITING (Upstash Redis) ────────────────────────────────────────────
# Optional in dev — falls back to in-memory. Required in production if you
# run more than one server instance.
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ─── ANALYTICS (Optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
